# Everything is optional. With nothing set, the app runs fully offline:
# text input instead of voice, rule-based extraction, no audio replies.

# Public URL of this server (used for did:web issuer and media links)
PUBLIC_BASE_URL=http://localhost:8000

# --- ElevenLabs (voice in / voice out) ---
# Model IDs: take them from the ElevenLabs docs (Kannada TTS needs an Eleven v3/v4 model)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=

# --- AWS Bedrock (LLM extraction of profile/job fields) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# --- Twilio WhatsApp sandbox (channel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
